<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F4F6"
    android:orientation="vertical"
    tools:context=".presentation.history.OmrStudentHistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1F2937"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/omr_student_history_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOmrStudentHistoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="2"
            android:textColor="#FF86EFAC"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Ana Beatriz" />

        <TextView
            android:id="@+id/textOmrStudentHistoryIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FFD1D5DB"
            android:textSize="13sp"
            tools:text="Matrícula: 000123 • Turma: 9 A" />

        <TextView
            android:id="@+id/textOmrStudentHistorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#FF9CA3AF"
            android:textSize="12sp"
            tools:text="3 resultados registrados" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/textOmrStudentHistoryFinalCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFDCFCE7"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="7dp"
            android:textColor="#FF166534"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Concluídos\n1" />

        <TextView
            android:id="@+id/textOmrStudentHistoryReviewCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="#FFFEF3C7"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="7dp"
            android:textColor="#FF92400E"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Revisar\n1" />

        <TextView
            android:id="@+id/textOmrStudentHistoryPendingCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="#FFFEE2E2"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="7dp"
            android:textColor="#FF991B1B"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Pendentes\n1" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <ListView
            android:id="@+id/listOmrStudentHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_omr_student_history" />

        <LinearLayout
            android:id="@+id/containerOmrStudentHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/omr_student_history_empty_title"
                android:textColor="#FF111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/omr_student_history_empty_message"
                android:textColor="#FF6B7280"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/buttonOmrStudentHistoryBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/omr_student_history_action_back" />

    </LinearLayout>

</LinearLayout>
