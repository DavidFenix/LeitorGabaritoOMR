<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:minHeight="78dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewOmrGradeQuestionIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#FF22C55E" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="8dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/textOmrGradeQuestionPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Questão 15" />

        <TextView
            android:id="@+id/textOmrGradeQuestionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FF4B5563"
            android:textSize="13sp"
            tools:text="Incorreta • marcada: B • gabarito: D" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textOmrGradeQuestionPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF111827"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="0/1 ponto(s)" />

        <TextView
            android:id="@+id/textOmrGradeQuestionConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FF6B7280"
            android:textSize="11sp"
            tools:text="Confiança: 91%" />

    </LinearLayout>

</LinearLayout>
