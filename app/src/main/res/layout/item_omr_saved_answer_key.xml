<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:minHeight="150dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewOmrAnswerKeyActiveIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#FFD1D5DB" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textOmrAnswerKeyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textColor="#FF111827"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Avaliação diagnóstica de Matemática" />

            <TextView
                android:id="@+id/textOmrAnswerKeyActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#FFDCFCE7"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/omr_answer_key_list_active_badge"
                android:textColor="#FF166534"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textOmrAnswerKeyVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF374151"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Versão 1" />

            <TextView
                android:id="@+id/textOmrAnswerKeyQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FF374151"
                android:textSize="13sp"
                tools:text="52 questões" />

            <TextView
                android:id="@+id/textOmrAnswerKeyWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FF374151"
                android:textSize="13sp"
                tools:text="Peso total: 52,00" />

        </LinearLayout>

        <TextView
            android:id="@+id/textOmrAnswerKeyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:textColor="#FF6B7280"
            android:textSize="12sp"
            tools:text="Folha: avalie-ce-development • versão 1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonOmrAnswerKeySelect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:minHeight="44dp"
                android:text="@string/omr_answer_key_list_action_select"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonOmrAnswerKeyDelete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="@string/omr_answer_key_list_action_delete"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
