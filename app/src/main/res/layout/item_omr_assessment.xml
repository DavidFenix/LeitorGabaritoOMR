<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:minHeight="126dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOmrAssessmentItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="#FF111827"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Avaliação bimestral" />

        <TextView
            android:id="@+id/textOmrAssessmentItemMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FF374151"
            android:textSize="14sp"
            tools:text="Matemática • 9º ano • 2026" />

        <TextView
            android:id="@+id/textOmrAssessmentItemPeriodVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FF4B5563"
            android:textSize="13sp"
            tools:text="2º bimestre • versão 3" />

        <TextView
            android:id="@+id/textOmrAssessmentItemAnswerKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:textColor="#FF6B7280"
            android:textSize="12sp"
            tools:text="Gabarito: key-math • versão 2" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonOmrAssessmentItemNewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minHeight="44dp"
        android:text="@string/omr_assessment_list_action_new_version"
        android:textSize="11sp" />

</LinearLayout>
