<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:minHeight="68dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewOmrQuestionStatusIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#FF22C55E" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/textOmrQuestionPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Questão 15" />

        <TextView
            android:id="@+id/textOmrQuestionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FF4B5563"
            android:textSize="14sp"
            tools:text="Múltiplas marcações: B, D" />

    </LinearLayout>

    <TextView
        android:id="@+id/textOmrQuestionConfidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="end"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="#FF6B7280"
        android:textSize="12sp"
        tools:text="Confiança: 78%" />

</LinearLayout>
