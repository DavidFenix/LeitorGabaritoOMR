<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:minHeight="92dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/viewOmrManualQuestionIndicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="#FFF59E0B" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/textOmrManualQuestionPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Questão 18" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupOmrManualQuestionOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:visibility="visible"
            app:selectionRequired="false"
            app:singleLine="false"
            app:singleSelection="true"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textOmrManualQuestionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/omr_manual_key_question_pending"
            android:textColor="#FF92400E"
            android:textSize="12sp"
            tools:text="Resposta selecionada: C" />

    </LinearLayout>

</LinearLayout>
