<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:opencv="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true"
    tools:context=".presentation.capture.OmrCaptureActivity">

    <org.opencv.android.JavaCameraView
        android:id="@+id/cameraViewOmrCapture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        opencv:camera_id="back"
        opencv:show_fps="false" />

    <LinearLayout
        android:id="@+id/panelOmrCaptureStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="#D91F2937"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/textOmrCaptureInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/omr_capture_instruction_position_sheet"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressOmrCapture"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#66728191"
            android:progressTint="#FF22C55E"
            android:visibility="gone"
            tools:progress="64"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textOmrCaptureProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#FFE5E7EB"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Confirmando respostas: 64%"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textOmrCaptureDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFFCA5A5"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Detalhes: diagnóstico da captura"
            tools:visibility="visible" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonOmrCaptureRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:minHeight="48dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/omr_capture_action_retry"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
