<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F4F6"
    android:orientation="vertical"
    tools:context=".presentation.assessment.OmrAssessmentApplicationRosterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1F2937"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textOmrApplicationRosterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="Avaliação bimestral" />

        <TextView
            android:id="@+id/textOmrApplicationRosterAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFD1D5DB"
            android:textSize="13sp"
            tools:text="Matemática • prova v2 • assessment-1" />

        <TextView
            android:id="@+id/textOmrApplicationRosterClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FFD1D5DB"
            android:textSize="13sp"
            tools:text="Chamada congelada: 9º A" />

        <TextView
            android:id="@+id/textOmrApplicationRosterProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF86EFAC"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="18 de 30 corrigidos • 12 pendentes" />

        <TextView
            android:id="@+id/textOmrApplicationRosterCreatedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FF9CA3AF"
            android:textSize="11sp"
            tools:text="Criada em 12/10/2026 09:30 • application-1" />

        <TextView
            android:id="@+id/textOmrApplicationRosterCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="30 participantes" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutOmrApplicationRosterSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/omr_application_roster_search_hint"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editOmrApplicationRosterSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <ListView
            android:id="@+id/listOmrApplicationRoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="7dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_omr_assessment_application_participant" />

        <LinearLayout
            android:id="@+id/containerOmrApplicationRosterNoResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/omr_application_roster_no_results_title"
                android:textColor="#FF111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/omr_application_roster_no_results_message"
                android:textColor="#FF6B7280"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressOmrApplicationRoster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/buttonOmrApplicationRosterNextPending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:minHeight="48dp"
        android:text="@string/omr_application_roster_action_next_pending" />

    <Button
        android:id="@+id/buttonOmrApplicationRosterBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:text="@string/omr_application_roster_action_back" />
</LinearLayout>
