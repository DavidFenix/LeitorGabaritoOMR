<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:minHeight="104dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOmrClassItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="#FF111827"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="9º ano A" />

        <TextView
            android:id="@+id/textOmrClassItemMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FF4B5563"
            android:textSize="14sp"
            tools:text="Ensino Fundamental • 2026" />

        <TextView
            android:id="@+id/textOmrClassItemStudentCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FF047857"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="36 alunos na lista" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/buttonOmrClassItemRoster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/omr_class_list_action_roster"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonOmrClassItemEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="42dp"
            android:text="@string/omr_class_list_action_edit"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
