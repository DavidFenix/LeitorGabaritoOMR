<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textOmrAssessmentStructureTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Caderno de Ciências da Natureza • versão 1 • 45 questões" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/omr_assessment_structure_editor_helper"
            android:textColor="#FF4B5563"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/containerOmrAssessmentStructureBlocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonOmrAssessmentStructureAddBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="46dp"
            android:text="@string/omr_assessment_structure_action_add_block" />

        <TextView
            android:id="@+id/textOmrAssessmentStructureTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FF374151"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Total informado: 45 de 45 questões" />

    </LinearLayout>

</ScrollView>
