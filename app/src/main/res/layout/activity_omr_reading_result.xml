<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F4F6"
    android:orientation="vertical"
    tools:context=".presentation.result.OmrReadingResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1F2937"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/omr_result_title"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOmrResultOverall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FF86EFAC"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Leitura concluída com itens para revisar" />

        <TextView
            android:id="@+id/textOmrResultLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFD1D5DB"
            android:textSize="13sp"
            tools:text="Gabarito Avalie CE • versão 1" />

        <TextView
            android:id="@+id/textOmrResultCapturedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FF9CA3AF"
            android:textSize="12sp"
            tools:text="Capturada em 25/08/2026 11:30" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/omr_result_summary_title"
                android:textColor="#FF111827"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textOmrResultCountSingle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FFDCFCE7"
                    android:gravity="center"
                    android:minHeight="70dp"
                    android:padding="10dp"
                    android:textColor="#FF166534"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Respondidas\n47" />

                <TextView
                    android:id="@+id/textOmrResultCountBlank"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFE5E7EB"
                    android:gravity="center"
                    android:minHeight="70dp"
                    android:padding="10dp"
                    android:textColor="#FF374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Em branco\n3" />

                <TextView
                    android:id="@+id/textOmrResultCountReview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFFEF3C7"
                    android:gravity="center"
                    android:minHeight="70dp"
                    android:padding="10dp"
                    android:textColor="#FF92400E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Para revisar\n2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textOmrResultCountMultiple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FFFCE7F3"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="8dp"
                    android:textColor="#FF9D174D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Múltiplas\n1" />

                <TextView
                    android:id="@+id/textOmrResultCountAmbiguous"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFFFEDD5"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="8dp"
                    android:textColor="#FF9A3412"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Ambíguas\n1" />

                <TextView
                    android:id="@+id/textOmrResultCountNotReady"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFFEE2E2"
                    android:gravity="center"
                    android:minHeight="64dp"
                    android:padding="8dp"
                    android:textColor="#FF991B1B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Pendentes\n0" />

            </LinearLayout>

            <TextView
                android:id="@+id/textOmrResultReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFFFFBEB"
                android:padding="14dp"
                android:textColor="#FF92400E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2 questões exigem conferência antes de continuar."
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/omr_result_questions_title"
                android:textColor="#FF111827"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerOmrResultQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/buttonOmrResultReadAgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/omr_result_action_read_again" />

        <Button
            android:id="@+id/buttonOmrResultFinish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/omr_result_action_finish" />

    </LinearLayout>

</LinearLayout>
