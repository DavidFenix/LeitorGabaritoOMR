        <item quantity="other">Cartão preparado para %1$d questões, com %2$d alternativas • %3$s • %4$s</item>
    </plurals>

    <string name="omr_sheet_export_file_title">
        3. Salve o arquivo SVG
    </string>

    <string name="omr_sheet_export_text_customization_title">
        2. Personalize os textos (opcional)
    </string>

    <string name="omr_sheet_export_text_customization_message">
        Edite o cabeçalho, a instrução técnica e o rodapé. Apague todo o conteúdo de um campo para não imprimir aquele texto. A identificação técnica do modelo permanece fixa.
    </string>

    <string name="omr_sheet_export_header_hint">
        Cabeçalho do cartão
    </string>

    <string name="omr_sheet_export_instruction_hint">
        Instrução técnica
    </string>

    <string name="omr_sheet_export_footer_hint">
        Rodapé do cartão
    </string>

    <string name="omr_sheet_export_restore_default_texts">
        Restaurar textos padrão
    </string>

    <string name="omr_sheet_export_format_description">
        O SVG mantém linhas e textos nítidos ao ser inserido no Word, LibreOffice ou outro editor compatível.
    </string>

    <string name="omr_sheet_export_filename_format">
        cartao-resposta-%1$03d-itens-%2$d-alternativas-%3$03d-por-coluna-v4.svg
    </string>

    <string name="omr_sheet_export_size_description">
        A largura original acompanha as colunas utilizadas, até o máximo de 18 cm. A altura acompanha os itens por coluna.
    </string>

    <string name="omr_sheet_export_proportion_title">
        Preserve a proporção
    </string>

    <string name="omr_sheet_export_proportion_message">
        Ao redimensionar, mantenha a proporção entre largura e altura. Esticar apenas um dos lados pode reduzir a confiabilidade da leitura.
    </string>

    <string name="omr_sheet_export_action_back">
