    <plurals name="omr_sheet_export_column_count">
        <item quantity="one">%1$d coluna</item>
        <item quantity="other">%1$d colunas</item>
    </plurals>

    <plurals name="omr_sheet_export_question_count">
        <item quantity="one">%1$d questão</item>
        <item quantity="other">%1$d questões</item>
    </plurals>

