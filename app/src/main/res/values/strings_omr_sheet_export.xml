<resources>

    <string name="omr_lab_action_open_sheet_export">
        Gerar cartão-resposta
    </string>

    <string name="omr_sheet_export_title">
        Gerar cartão-resposta
    </string>

    <string name="omr_sheet_export_subtitle">
        Crie um cartão padronizado com alternativas A–D ou A–E para inserir e imprimir junto da avaliação.
    </string>

    <string name="omr_sheet_export_count_title">
        1. Escolha a quantidade de questões
    </string>

    <string name="omr_sheet_export_count_message">
        Escolha qualquer quantidade inteira de 1 a 90 e ajuste a distribuição das colunas, se desejar.
    </string>

    <string name="omr_sheet_export_count_content_description">
        Quantidade de questões do cartão-resposta
    </string>

    <string name="omr_sheet_export_option_count_title">
        Quantidade de alternativas por questão
    </string>

    <string name="omr_sheet_export_option_count_content_description">
        Quantidade de alternativas de cada questão
    </string>

    <string-array name="omr_sheet_export_option_count_entries">
        <item>4 alternativas (A–D)</item>
        <item>5 alternativas (A–E)</item>
    </string-array>

    <string name="omr_sheet_export_questions_per_column_title">
        Itens por coluna
    </string>

    <string name="omr_sheet_export_questions_per_column_message">
        Use o modo automático ou escolha quantos itens cada coluna deverá comportar.
    </string>

    <string name="omr_sheet_export_questions_per_column_content_description">
        Quantidade de itens em cada coluna do cartão-resposta
    </string>

